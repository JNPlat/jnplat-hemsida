// Cloudflare Workers: publicerar sajten som statiska filer.
// Cloudflare kör "npx wrangler deploy" vid varje push till main.
{
  "name": "jnplat-hemsida",
  "compatibility_date": "2026-10-01",
  // Före varje publicering: bygget fyller i texterna från content/*.json
  // (Pages CMS), sedan körs kontrollen. Blir något fel avbryts publiceringen
  // och den förra versionen ligger kvar.
  "build": {
    "command": "node scripts/build.mjs && node scripts/validate-site.mjs"
  },
  "assets": {
    "directory": "./"
  }
}
